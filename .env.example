# Copy to .env and fill in. Never commit real secrets.
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hms
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Any long random string, e.g. generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string
